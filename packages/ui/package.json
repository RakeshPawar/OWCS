{
  "name": "@owcs/ui",
  "version": "0.1.12",
  "description": "Open Web Component Specification UI - Web Component for rendering OWCS specifications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RakeshPawar/OWCS"
  },
  "keywords": [
    "owcs",
    "web-components",
    "open-web-component-specification"
  ],
  "dependencies": {
    "@owcs/api": "workspace:*",
    "@owcs/schemas": "workspace:*",
    "lit": "^3.1.2",
    "highlight.js": "^11.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
